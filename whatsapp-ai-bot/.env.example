# --- Server ---
PORT=3000

# --- Anthropic (Claude) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model used for the conversation agent. claude-opus-4-8 is the most capable;
# switch to claude-haiku-4-5 if you need lower latency/cost at high volume.
CLAUDE_MODEL=claude-opus-4-8

# --- WhatsApp Cloud API (Meta) ---
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose — must match the "Verify Token" you set in the Meta App webhook config.
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_API_VERSION=v21.0

# WhatsApp number (E.164, no +) of the business owner/staff who gets lead &
# order notifications, e.g. 254742909700
OWNER_WHATSAPP_NUMBER=

# --- M-Pesa Daraja API (Safaricom) ---
# https://developer.safaricom.co.ke/
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Publicly reachable HTTPS URL where Safaricom posts the STK push result.
MPESA_CALLBACK_URL=https://your-domain.example.com/webhook/mpesa/callback

# --- Business config ---
BUSINESS_NAME="Your Business"
BUSINESS_TIMEZONE=Africa/Nairobi

# --- Database ---
DATABASE_PATH=./data.sqlite
